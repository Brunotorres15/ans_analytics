   "source": [
    "%sql\n",
    "\n",
    "CREATE OR REPLACE TABLE dev.gold.DIM_TRIMESTRE\n",
    "LOCATION \"s3://novadrive-project/gold/dim_trimestre\"\n",
    "AS\n",
    "SELECT \n",
    "  monotonically_increasing_id() AS SK_TRIMESTRE,\n",
    "  ID_TRIMESTRE\n",
    "FROM (\n",
    "  SELECT DISTINCT ID_TRIMESTRE FROM dev.silver.silver_sip\n",
    ");"
   ]
  }
