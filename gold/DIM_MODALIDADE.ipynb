   "source": [
    "%sql\n",
    "\n",
    "CREATE OR REPLACE TABLE dev.gold.DIM_MODALIDADE\n",
    "LOCATION \"s3://novadrive-project/gold/dim_modalidade\"\n",
    "AS\n",
    "SELECT \n",
    "  monotonically_increasing_id() AS SK_MODALIDADE,\n",
    "  GR_MODALIDADE AS NM_MODALIDADE\n",
    "FROM (\n",
    "  SELECT DISTINCT GR_MODALIDADE FROM dev.silver.silver_sip\n",
    ");\n",
    "\n"
   ]
  }
